class Solution{   
public:
    bool Recursion(int index,int sum,vector<int>&arr,int target){
        int n=arr.size();
        if(index==n) return sum==target;
        if(Recursion(index+1,sum+arr[index],arr,target)) return true;
        if(Recursion(index+1,sum,arr,target)) return true;
        return false;

    }
    bool isSubsetSum(vector<int>arr, int target){
       return Recursion(0,0,arr,target);
  
    }
};
