/**
 * Definition for a binary tree node.
 * class TreeNode {
 *     int data;
 *     TreeNode *left;
 *     TreeNode *right;
 *      TreeNode(int val) : data(val) , left(nullptr) , right(nullptr) {}
 * };
 **/

class Solution{	
	public:
		vector<int> floorCeilOfBST(TreeNode* root,int key){
			int floor=-1;int ceil=-1;
            while(root){
                if(root->data==key){
                    return {root->data,root->data};
                }
                if(key>root->data){
                    floor=root->data;
                    root=root->right;
                }
                else{
                    ceil=root->data;
                    root=root->left;
                }
            }
            return {floor,ceil};
		}
};
