class Solution {
public:
    static bool comparative(vector<int>& a,vector<int>& b) {
        return a[2]>b[2];
    }
    vector<int>JobScheduling(vector<vector<int>>& Jobs) {
        int n=Jobs.size();
        int count=0,totalprofit=0;
        int maxdead=0;
        sort(Jobs.begin(),Jobs.end(),comparative);
        for (int i=0;i<n;i++) {
            maxdead=max(maxdead,Jobs[i][1]);
        }
        vector<int>hash(maxdead+1,-1);
        for(int i=0;i<n;i++) {
            for(int j=Jobs[i][1];j>0;j--) {
                if(hash[j]==-1) {
                    hash[j]=Jobs[i][0];
                    count++;
                    totalprofit+=Jobs[i][2];
                    break;
                }
            }
        }
        return{count,totalprofit};
    }
};
